# Copy to .env at the repository root. Never put keys in the frontend.
DATABASE_URL=sqlite:///./data/researchos.db
# PostgreSQL alternative: postgresql+psycopg://researchos:researchos@localhost:5432/researchos
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
# Free OpenRouter setup: LLM_BASE_URL=https://openrouter.ai/api/v1,
# LLM_MODEL=openrouter/free, LLM_FREE_ONLY=true, EMBEDDINGS_ENABLED=false.
LLM_FREE_ONLY=false
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=text-embedding-3-small
# Optional separate embedding provider; defaults to LLM_API_KEY / LLM_BASE_URL.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
DATA_DIR=./data

# Optional Redis search cache (Docker Compose configures this automatically).
REDIS_URL=
